{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "job": { "type": "string" },
    "id": { "type": "string" },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}.*"
    }
  },
  "required": ["name", "job", "id", "createdAt"]
}
